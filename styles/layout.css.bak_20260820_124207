*{
box-sizing:border-box
}html{
scroll-behavior:smooth
}body{
margin:0;background:radial-gradient(circle at 12% 10%,rgba(19,166,220,.13),transparent 34%),linear-gradient(160deg,#eaf7ff 0%,#f9fcff 42%,#d9effb 100%);color:var(--ink);font-family:"方正兰亭黑","Source Han Sans SC","PingFang SC",sans-serif;min-height:100vh
}
button,input,textarea,select{
font:inherit
}.app{
padding:24px
}.toolbar{
max-width:1500px;margin:0 auto 12px;display:flex;align-items:end;justify-content:space-between;gap:16px
}.eyebrow{
font-size:11px;letter-spacing:.3em;color:#4580a9
}.toolbar h1{
margin:4px 0 0;font-size:18px;color:#0b4772
}.hint{
font-size:12px;color:#5e829c
}.atlas{
width:min(1500px,100%);aspect-ratio:1.25;margin:auto;background:#eef8ff;border:1px solid #7bbce2;box-shadow:var(--shadow);display:grid;grid-template-rows:5.4% 22.8% 1fr;overflow:hidden
}.atlas-title{
display:flex;align-items:center;justify-content:center;background:linear-gradient(90deg,#07365f,#0a4d7c 50%,#07365f);border-bottom:4px solid #16b0e6;color:#fff;font-size:clamp(20px,2.05vw,34px);font-weight:800;letter-spacing:.04em;text-shadow:0 2px 10px rgba(0,0,0,.2)
}
.top{
display:grid;grid-template-columns:40% 30% 30%;gap:3px;padding:7px 9px;background:#eef8ff
}.top-card{
min-width:0;background:#f7fcff;border:1px solid var(--line);display:grid;grid-template-rows:34px 1fr;overflow:hidden
}.top-head{
background:linear-gradient(180deg,#0d6099,#095183);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:750;font-size:clamp(13px,1.15vw,19px);letter-spacing:.03em
}.map{
display:flex;align-items:center;justify-content:center;background:#fff;overflow:hidden
}.map img{
width:97%;height:97%;object-fit:contain;filter:saturate(1.12) contrast(1.02)
}.flow{
display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:6px 14px;font-size:clamp(10px,.86vw,14px);line-height:1.24
}.flow-line{
width:100%;padding:4px 8px;border-bottom:1px solid #b8dbef
}.flow-line:last-child{
border-bottom:0
}.arrow{
color:#159bd4;font-weight:900;line-height:.8
}.main{
display:grid;grid-template-columns:7.6% 1fr 7.6%;gap:3px;padding:0 9px 9px;min-height:0
}.rail{
display:grid;grid-template-rows:9% 14% 15% 15% 15% 15% 17%;gap:3px;min-height:0
}.rail-cell{
background:linear-gradient(180deg,#0f82c5,#0b70ad);border:1px solid #78c8ef;color:#fff;display:flex;align-items:center;justify-content:center;text-align:center;padding:5px;font-size:clamp(9px,.75vw,13px);font-weight:750;line-height:1.2
}.rail-cell.head{
background:linear-gradient(180deg,#0b568c,#084a79);font-size:clamp(10px,.86vw,14px)
}.rail-cell.interactive{
cursor:pointer;transition:.2s
}.rail-cell.interactive:hover{
filter:brightness(1.16);transform:translateX(2px)
}.center{
display:grid;grid-template-rows:5.5% 12.5% 5.5% 1fr 4.8%;min-height:0
}.band{
display:flex;align-items:center;justify-content:center;background:#0a568a;color:#fff;font-weight:750;font-size:clamp(11px,.95vw,16px);letter-spacing:.02em
}.band.five{
background:#1488c9
}.goals{
display:grid;grid-template-columns:repeat(3,1fr);background:#fff;border:1px solid var(--line)
}.goal{
display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;border-right:1px solid var(--line);padding:3px
}.goal:last-child{
border-right:0
}.goal.revenue{
display:grid;grid-template-columns:1fr 1fr;gap:0
}.goal.revenue .goal-item{
min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:3px
}.goal.revenue .goal-item+ .goal-item{
border-left:1px solid var(--line)
}.goal.outcomes{
grid-column:span 2
}.goal strong{
font-size:clamp(17px,1.65vw,27px);line-height:1.05;color:#0877bd
}.goal span{
font-size:clamp(9px,.78vw,13px);margin-top:5px
}.matrix{
display:grid;grid-template-columns:8.5% repeat(5,1fr);grid-template-rows:8% 15% 18% 18% 13% 15% 13%;border-left:1px solid var(--line);border-top:1px solid var(--line);background:#fff;min-height:0
}.cell{
min-width:0;min-height:0;border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:4px 7px;display:flex;align-items:center;justify-content:center;text-align:center;font-size:clamp(7.5px,.64vw,10.8px);line-height:1.23;overflow:hidden
}.cell.head{
background:linear-gradient(180deg,#dff3ff,#cae8fa);font-size:clamp(9px,.78vw,13px);font-weight:750;color:#0c527f
}.cell.row{
background:#e1f2fc;font-weight:750;color:#175c88
}.cell.action{
cursor:pointer;position:relative;transition:.18s
}.cell.action:hover{
background:#e9f8ff;color:#006eaa;box-shadow:inset 0 0 0 2px rgba(16,145,208,.28)
}.cell.action::after{
content:"";position:absolute;right:4px;top:4px;width:4px;height:4px;border-radius:50%;background:#17a8dc;opacity:0;transition:.18s
}.cell.action:hover::after{
opacity:1
}.cell ul{
margin:0;padding:0;list-style:none;width:100%
}.cell li+li{
margin-top:2px
}.guarantee{
display:flex;align-items:center;justify-content:center;background:#1488c9;color:#fff;font-size:clamp(9px,.76vw,13px);font-weight:650;letter-spacing:.02em
}
.drawer-backdrop{
position:fixed;inset:0;background:rgba(2,22,39,.58);backdrop-filter:blur(8px);opacity:0;pointer-events:none;transition:.28s;z-index:20
}.drawer-backdrop.open{
opacity:1;pointer-events:auto
}.drawer{
position:fixed;z-index:21;inset:3vh 3vw;background:#f7fbfe;border:1px solid #76bce4;box-shadow:0 30px 100px rgba(1,33,57,.42);display:grid;grid-template-rows:auto auto 1fr;transform:translateY(20px) scale(.985);opacity:0;pointer-events:none;transition:.28s;overflow:hidden
}.drawer.open{
transform:none;opacity:1;pointer-events:auto
}.drawer-head{
background:linear-gradient(100deg,#07365f,#0a699f);color:#fff;padding:18px 22px;display:flex;align-items:center;justify-content:space-between;gap:20px
}.drawer-title small{
display:block;font-size:11px;letter-spacing:.22em;color:#87d8f6;margin-bottom:4px
}.drawer-title h2{
font-size:22px;margin:0
}.close{
width:38px;height:38px;border:1px solid rgba(255,255,255,.38);background:rgba(255,255,255,.08);color:#fff;border-radius:50%;cursor:pointer;font-size:20px
}.filters{
display:flex;gap:10px;padding:12px 18px;border-bottom:1px solid #c9e2f1;background:#edf7fd;flex-wrap:wrap
}.filters select,.filters input{
height:36px;border:1px solid #afd2e6;background:#fff;color:#24506e;padding:0 10px
}.filters input{
min-width:250px;flex:1
}.task-list{
padding:0 18px 20px;overflow:auto
}.list-head,.task-summary{
display:grid;grid-template-columns:minmax(430px,2.2fr) minmax(140px,.7fr) minmax(190px,1fr) 120px;gap:0
}.list-head{
position:sticky;top:0;z-index:2;background:#d7edf9;color:#0f527e;font-size:12px;font-weight:750
}.list-head div{
padding:10px 12px;border-right:1px solid #b7d7e9
}.task{
border:1px solid #c0dcea;border-top:0;background:#fff
}.task-summary{
cursor:pointer;transition:.18s
}.task-summary:hover{
background:#f1faff
}.task-summary>div{
padding:12px;border-right:1px solid #d3e7f2;font-size:13px;line-height:1.55
}.task-summary>div:last-child{
border-right:0
}.task-name{
display:flex;gap:10px
}.chev{
flex:0 0 18px;color:#0a83c0;font-weight:900;transition:.2s
}.task.open .chev{
transform:rotate(90deg)
}.task-detail{
display:grid;grid-template-rows:0fr;transition:grid-template-rows .28s ease;background:#f3f9fd
}.task-detail-inner{
overflow:hidden
}.task.open .task-detail{
grid-template-rows:1fr
}.detail-pad{
padding:18px;border-top:1px solid #beddeb
}.detail-box{
background:#fff;border-left:4px solid #129bd3;padding:15px 18px;box-shadow:0 8px 24px rgba(20,86,124,.08)
}.detail-box h3,.monthly h3{
margin:0 0 9px;color:#0b5888;font-size:15px
}.detail-box p{
margin:0;font-size:13px;line-height:1.85
}.meta{
display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:12px
}.meta div{
background:#eaf5fb;padding:9px 10px;font-size:12px
}.meta b{
display:block;color:#6a8ba0;font-weight:500;margin-bottom:3px
}.monthly{
margin-top:16px
}.monthly-top{
display:flex;align-items:center;justify-content:space-between;margin-bottom:8px
}.primary{
border:0;background:#0b78b7;color:#fff;padding:8px 15px;cursor:pointer;box-shadow:0 6px 16px rgba(11,120,183,.22)
}.progress-table{
width:100%;border-collapse:collapse;background:#fff;font-size:12px
}.progress-table th{
background:#dceef8;color:#0d547f;padding:9px;border:1px solid #bcd9e9
}.progress-table td{
padding:10px;border:1px solid #cfe3ee;vertical-align:top
}.empty{
text-align:center;color:#7895a8;padding:18px!important
}.modal-backdrop{
position:fixed;inset:0;background:rgba(2,22,39,.65);z-index:40;display:none;align-items:center;justify-content:center;padding:20px
}.modal-backdrop.open{
display:flex
}.modal{
width:min(760px,100%);max-height:90vh;overflow:auto;background:#fff;border-top:5px solid #0b78b7;box-shadow:0 24px 90px rgba(0,0,0,.4);padding:22px
}.modal h2{
margin:0 0 18px;color:#0a5688
}.form-grid{
display:grid;grid-template-columns:1fr 1fr;gap:14px
}.field{
display:flex;flex-direction:column;gap:6px;font-size:12px
}.field.full{
grid-column:1/-1
}.field label{
color:#416b86
}.field input,.field select,.field textarea{
border:1px solid #b7d5e6;padding:10px;background:#f9fcfe;color:#173d5f
}.field textarea{
min-height:78px;resize:vertical
}.modal-actions{
display:flex;justify-content:flex-end;gap:10px;margin-top:18px
}.secondary{
border:1px solid #a9cfe3;background:#fff;color:#245a7a;padding:8px 16px;cursor:pointer
}.toast{
position:fixed;right:24px;bottom:24px;background:#083f67;color:#fff;padding:12px 18px;z-index:60;transform:translateY(20px);opacity:0;transition:.25s
}.toast.show{
transform:none;opacity:1
}
/* 总图体系字号增强 */
.rail{
grid-template-rows:9fr 14fr 15fr 15fr 15fr 15fr 17fr
}
.atlas{
aspect-ratio:1.12;grid-template-rows:5.1% 26.2% 1fr
}.top-card{
grid-template-rows:36px minmax(0,1fr)
}.flow{
font-size:clamp(11.5px,.9vw,14.5px);line-height:1.18;padding:4px 10px;display:grid;grid-template-rows:1fr 12px 1.35fr 12px 1.15fr 1fr;align-items:stretch;overflow:hidden
}.flow-line{
min-height:0;padding:3px 8px;display:flex;align-items:center;justify-content:center;text-wrap:balance
}.flow .arrow{
display:flex;align-items:center;justify-content:center
}.flow-spacer{
visibility:hidden
}.matrix{
grid-template-rows:8fr 16fr 19fr 19fr 13fr 13fr 12fr
}.rail-cell{
font-size:clamp(11px,.9vw,15px);line-height:1.22
}.rail-cell.head{
font-size:clamp(12px,1vw,16px)
}.band{
font-size:clamp(13px,1.08vw,18px)
}.goal span{
font-size:clamp(11px,.9vw,15px)
}.cell{
font-size:clamp(10px,.91vw,14.5px);line-height:1.14;padding:3px 6px;text-wrap:balance
}.cell.head{
font-size:clamp(12px,1.02vw,16px)
}.cell.row{
font-size:clamp(11.5px,.98vw,15px)
}.guarantee{
font-size:clamp(11px,.9vw,15px)
}
@keyframes reveal{
from{
opacity:0;transform:translateY(10px)
}to{
opacity:1;transform:none
}
}@media(max-width:900px){
.app{
padding:10px
}.toolbar{
min-width:1120px
}.atlas{
min-width:1120px
}.app{
overflow-x:auto
}.drawer{
inset:1vh 1vw
}.list-head,.task-summary{
grid-template-columns:2fr .7fr 1fr 110px
}.meta{
grid-template-columns:1fr 1fr
}
}
/* 重点任务清单时间节点列防溢出 */
.list-head,.task-summary{
grid-template-columns:minmax(380px,2.1fr) minmax(130px,.7fr) minmax(170px,1fr) minmax(160px,.72fr)
}
.task-summary>div{
min-width:0;overflow-wrap:anywhere
}
.task-summary>div:last-child{
white-space:normal;word-break:break-word
}
@media(max-width:900px){
.list-head,.task-summary{
grid-template-columns:minmax(340px,2fr) minmax(125px,.7fr) minmax(160px,1fr) minmax(150px,.72fr)
}
}
.mechanism{
min-height:0;height:100%;display:grid;grid-template-columns:1fr auto 1fr;grid-template-rows:minmax(0,1fr) auto;column-gap:18px;padding:4px 18px;background:#f7fcff;color:#123f65;overflow:hidden;font-size:clamp(11.5px,.9vw,14.5px);line-height:1.18;align-items:center;justify-items:center
}.mechanism-chain{
width:100%;height:100%;min-height:0;display:grid;grid-template-rows:repeat(5,1fr);align-items:center;justify-items:center;text-align:center;font-size:inherit;font-weight:400
}.mechanism-up{
color:#168fd0;font-size:clamp(16px,1.4vw,23px);line-height:1
}.mechanism-next{
display:flex;align-items:center;justify-content:center;color:#0a568a;font-size:clamp(31px,3vw,49px);font-weight:400;transform:scaleX(.82)
}.mechanism-topics{
width:100%;height:100%;display:grid;grid-template-rows:repeat(5,1fr);align-items:center;justify-items:center;text-align:center;font-size:inherit;font-weight:400;line-height:inherit
}.mechanism-level{
grid-column:1/-1;text-align:center;padding-top:3px;font-size:inherit;font-weight:400;color:#123f65;letter-spacing:0;justify-self:center;transform:translateY(-5px)
}
.cell.action ul{
counter-reset:none;width:max-content;max-width:100%;margin:0 auto
}.cell.action li{
width:100%;display:grid;grid-template-columns:1.6em auto;align-items:center;justify-content:start;text-align:left;font:inherit;color:inherit
}.cell.action li::before{
content:none
}.cell.action .task-no{
font:inherit;color:inherit;text-align:right
}.cell.action .task-text{
font:inherit;color:inherit;text-align:left
}
.news-ticker{
width:min(1500px,100%);height:42px;margin:8px auto 0;display:grid;grid-template-columns:auto minmax(0,1fr);overflow:hidden;border:1px solid #7bbce2;background:#f7fcff;box-shadow:0 12px 30px rgba(5,48,82,.12);color:#173d5f
}.ticker-label{
position:relative;z-index:2;display:flex;align-items:center;gap:10px;padding:0 18px;background:linear-gradient(110deg,#07365f,#096ca9);color:#fff;font-size:13px;font-weight:750;white-space:nowrap
}.ticker-label::after{
content:"";position:absolute;right:-12px;top:0;border-top:20px solid transparent;border-bottom:20px solid transparent;border-left:12px solid #096ca9
}.ticker-date{
font-size:11px;font-weight:500;color:#9fe2fb
}.ticker-window{
position:relative;min-width:0;overflow:hidden;display:flex;align-items:center;margin-left:12px;mask-image:linear-gradient(90deg,transparent,#000 4%,#000 96%,transparent);-webkit-mask-image:linear-gradient(90deg,transparent,#000 4%,#000 96%,transparent)
}.ticker-track{
display:flex;align-items:center;width:max-content;min-width:max-content;animation:ticker-scroll 42s linear infinite;will-change:transform
}.news-ticker:hover .ticker-track,.news-ticker:focus-within .ticker-track{
animation-play-state:paused
}.ticker-item{
display:inline-flex;align-items:center;gap:7px;padding:0 24px;white-space:nowrap;font-size:13px
}.ticker-item::before{
content:"";width:5px;height:5px;border-radius:50%;background:#17a8dc;box-shadow:0 0 0 3px rgba(23,168,220,.12)
}.ticker-item b{
color:#0877bd;font-weight:700
}.ticker-note{
color:#5e829c
}@keyframes ticker-scroll{
from{
transform:translateX(0)
}to{
transform:translateX(-50%)
}
}@media(prefers-reduced-motion:reduce){
.ticker-track{
animation:none
}.ticker-window{
overflow-x:auto;mask-image:none;-webkit-mask-image:none
}
}